# Copy this file to mac_mini/config.env and edit it. No secrets belong here.
# (mac_mini/setup.sh creates it for you and picks a model that fits this Mac.)

# The trader's name. It appears in his diary and in chat.
TRADER_NAME=Midas

# The Ollama model he runs on. Pick one that fits this Mac's memory
# (see the table in MAC_MINI_SETUP.md), then download it with: ollama pull <model>
MODEL=gpt-oss:20b

# Optional. His personality file, inside memory/. Copy PERSONA.md to a new name
# to experiment with a different character without losing the original.
# PERSONA_FILE=PERSONA.md

# Optional. How hard the model reasons before answering (models that support it):
# low, medium or high. Lower is faster. Leave unset to use the model's default.
# THINK=low

# Optional. Rival characters who also make picks each day (picks only, no
# diary). Their picks are scored next to his in memory/REVIEW.md, which shows
# whether a model's personality changes how it trades. Remove the line to
# switch the experiment off.
RIVALS="Prudence:personas/cautious.md Quill:personas/quant.md"
